generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String           @id @default(cuid())
  email           String           @unique
  passwordHash    String
  name            String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  subscriptions   Subscription[]
  votes           Vote[]
  retentionOffers RetentionOffer[]
  savedAmount     Float            @default(0)
}

model SaasCompany {
  id                 String           @id @default(cuid())
  name               String           @unique
  slug               String           @unique
  logo               String?
  website            String?
  category           String
  avgMonthlyPrice    Float?
  cancellationUrl    String?
  cancellationPhone  String?
  cancellationEmail  String?
  cancellationSteps  Json
  difficultyScore    Float            @default(3)
  darkPatternScore   Float            @default(0)
  totalCancellations Int              @default(0)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  subscriptions      Subscription[]
  retentionOffers    RetentionOffer[]
  votes              Vote[]
}

model Subscription {
  id           String      @id @default(cuid())
  userId       String
  user         User        @relation(fields: [userId], references: [id])
  companyId    String
  company      SaasCompany @relation(fields: [companyId], references: [id])
  monthlyPrice Float
  billingCycle String
  renewalDate  DateTime?
  status       String      @default("active")
  savedAmount  Float       @default(0)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

model RetentionOffer {
  id          String      @id @default(cuid())
  companyId   String
  company     SaasCompany @relation(fields: [companyId], references: [id])
  userId      String
  user        User        @relation(fields: [userId], references: [id])
  offerType   String
  description String
  discountPct Float?
  duration    String?
  script      String?
  verified    Boolean     @default(false)
  upvotes     Int         @default(0)
  downvotes   Int         @default(0)
  createdAt   DateTime    @default(now())
}

model Vote {
  id         String       @id @default(cuid())
  userId     String
  user       User         @relation(fields: [userId], references: [id])
  companyId  String?
  company    SaasCompany? @relation(fields: [companyId], references: [id])
  offerId    String?
  voteType   String
  targetType String
  createdAt  DateTime     @default(now())

  @@unique([userId, offerId, targetType])
  @@unique([userId, companyId, targetType])
}

model ContractScan {
  id                 String   @id @default(cuid())
  userId             String?
  inputText          String
  dangerScore        Float
  findings           Json
  autoRenewal        Boolean
  cancellationWindow String?
  penaltyClauses     Json?
  createdAt          DateTime @default(now())
}
